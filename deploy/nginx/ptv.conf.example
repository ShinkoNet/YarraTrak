limit_req_zone $binary_remote_addr zone=yarratrak_requests:10m rate=10r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

upstream ptv_fastapi {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name ptv.yourinternal.domain;

    ssl_certificate     /etc/nginx/ssl/yourinternal.website.crt;
    ssl_certificate_key /etc/nginx/ssl/yourinternal.website.key;

    # Replace these with the exact internal and VPN CIDRs you trust.
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 100.64.0.0/10;
    allow fd00::/8;
    deny all;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /ws {
        limit_req zone=yarratrak_requests burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://ptv_fastapi;
        proxy_http_version 1.1;
        # Location-level headers override the entire server-level header set.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://ptv_fastapi;
        proxy_read_timeout 90s;
    }
}

server {
    listen 443 ssl http2;
    server_name ptv.netcavy.net;
    # Install deploy/nginx/cloudflare-real-ip.conf at this path if proxied by Cloudflare.
    include /etc/nginx/cloudflare-real-ip.conf;
    client_max_body_size 32k;

    ssl_certificate     /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;

    set $public_appstore_url https://apps.repebble.com/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = / {
        return 302 $public_appstore_url;
    }

    location = /index.html {
        return 302 $public_appstore_url;
    }

    location ^~ /internal/ {
        return 404;
    }

    location /ws {
        limit_req zone=yarratrak_requests burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://ptv_fastapi;
        proxy_http_version 1.1;
        # Location-level headers override the entire server-level header set.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

    location ^~ /api/ {
        limit_req zone=yarratrak_requests burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://ptv_fastapi;
        proxy_read_timeout 90s;
    }

    location = /pebble-config.html {
        proxy_pass http://ptv_fastapi;
        proxy_read_timeout 90s;
    }
}
